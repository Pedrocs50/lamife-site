---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; slug?: string }
const { lang, title, description, slug = '' } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} · ${t.labName}` : `${t.labName} · ${t.labFull}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? t.labFull} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} slug={slug} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script is:inline>
      // Level 1 effect: reveal elements as they enter the viewport.
      const els = document.querySelectorAll('.reveal, .flow');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
      // Header: smaller with a shadow once the page is scrolled.
      const onScroll = () => document.documentElement.classList.toggle('scrolled', window.scrollY > 16);
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    </script>
    <style>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 1rem; top: 1rem; background: var(--bg); padding: .5rem 1rem; z-index: 10; border-radius: var(--radius); }
    </style>
  </body>
</html>
