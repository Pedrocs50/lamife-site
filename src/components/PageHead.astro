---
interface Props { title: string; lead?: string; eyebrow?: string; accent?: string }
const { title, lead, eyebrow, accent } = Astro.props;
---
<section class="page-head" style={accent ? `--c:${accent}` : undefined}>
  <div class:list={['wrap', 'head-grid', Astro.slots.has('aside') && 'has-aside']}>
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    {Astro.slots.has('aside') && <div class="aside"><slot name="aside" /></div>}
  </div>
</section>
<style>
  .page-head { padding: 4rem 0 3rem; border-bottom: 1px solid var(--line); border-top: 4px solid var(--c, transparent); }
  .head-grid.has-aside { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; }
  .lead { font-size: 1.2rem; color: var(--ink-soft); margin: 0; }
  .aside { color: var(--c, var(--brand)); }
  .aside { width: min(440px, 40vw); }
  .aside :global(.line-icon) { width: 120px; height: 120px; stroke-width: 1.6; }
  @media (max-width: 800px) { .aside { width: 100%; max-width: 440px; } }
  @media (max-width: 640px) { .head-grid.has-aside { grid-template-columns: 1fr; } .aside :global(.line-icon) { width: 72px; height: 72px; } }
</style>
