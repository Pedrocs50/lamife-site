---
import { nav, ui, type Lang } from '../i18n/ui';
import { researchLines, partners, news, tr } from '../data/content';
import { fmtDate } from '../i18n/path';
import HeroVisual from './HeroVisual.astro';
import LineIcon from './LineIcon.astro';
import Pipeline from './Pipeline.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'pt' ? `${base}/pt` : base;
const latest = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>{t.heroTitle}</h1>
      <p class="lead">{t.heroLead}</p>
      <p class="actions">
        <a class="btn" href={`${prefix}/research/`}>{t.ctaResearch}</a>
        <a class="btn ghost" href={`${prefix}/join/`}>{t.ctaJoin}</a>
      </p>
    </div>
    <div class="hero-art"><HeroVisual lang={lang} /></div>
  </div>
</section>

<section class="section">
  <div class="wrap reveal">
    <h2>{t.whatTitle}</h2>
    <p>{t.whatBody}</p>
    <Pipeline lang={lang} />
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h2 class="reveal">{t.linesTitle}</h2>
    <div class="grid cols-3">
      {researchLines.map((l) => (
        <a class="card line reveal" style={`--c:${l.accent}`} href={`${prefix}/research/${l.slug}/`}>
          <span class="badge"><LineIcon slug={l.slug} /><span class="tag">{l.letter}</span></span>
          <h3>{tr(l.title, lang)}</h3>
          <p class="muted">{tr(l.tagline, lang)}</p>
        </a>
      ))}
    </div>
    <p class="more reveal"><a href={`${prefix}/research/`}>{t.linesAll} →</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap reveal">
    <h2>{t.partnersTitle}</h2>
    <p class="muted">{t.partnersNote}</p>
    <p>{partners.map((n) => <span class="tag">{n}</span>)}</p>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h2 class="reveal">{t.newsTitle}</h2>
    <div class="grid cols-3">
      {latest.map((n) => (
        <a class="card reveal" href={`${prefix}/news/`}>
          <span class="tag">{fmtDate(n.date, lang)}</span>
          <h3>{tr(n.title, lang)}</h3>
        </a>
      ))}
    </div>
    <p class="more reveal"><a href={`${prefix}/news/`}>{t.newsAll} →</a></p>
  </div>
</section>

<section class="section">
  <div class="wrap join reveal">
    <h2>{t.joinTitle}</h2>
    <p>{t.joinBody}</p>
    <a class="btn" href={`${prefix}/join/`}>{nav[5][lang]}</a>
  </div>
</section>

<style>
  .hero { position: relative; padding: 4.5rem 0 4rem; background: linear-gradient(180deg, var(--surface), var(--bg)); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 2rem; align-items: center; }
  .hero-art { max-width: 560px; justify-self: end; width: 100%; }
  @media (max-width: 900px) {
    .hero { padding: 3rem 0 2.5rem; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-art { max-width: 460px; justify-self: center; }
  }
  .lead { font-size: 1.25rem; color: var(--ink-soft); }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .card { display: block; text-decoration: none; color: inherit; }
  .card h3 { margin-top: .75rem; color: var(--ink); }
  .more { margin-top: 1.5rem; font-weight: 600; }
  .join { text-align: left; }
  .tag { margin: 0 .35rem .35rem 0; }
</style>
