---
import PageHead from './PageHead.astro';
import { ui, type Lang } from '../i18n/ui';
import { pages } from '../i18n/pages';
import { researchLines, reading, tr } from '../data/content';
import { prefixFor } from '../i18n/path';
import LineIcon from './LineIcon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].research;
const prefix = prefixFor(lang);
const methods = [...new Set(researchLines.flatMap((l) => l.methods))];
---
<PageHead title={p.title} lead={p.lead} eyebrow={ui[lang].labName} />

<nav class="toc wrap" aria-label="On this page">
  <a href="#extreme">{p.extremeTitle}</a>
  <a href="#why">{p.whyTitle}</a>
  <a href="#lines">{p.linesTitle}</a>
  <a href="#methods">{p.methodsTitle}</a>
  <a href="#reading">{p.readingTitle}</a>
</nav>

<section class="section" id="extreme">
  <div class="wrap reveal"><h2>{p.extremeTitle}</h2><p>{p.extremeBody}</p></div>
</section>
<section class="section alt" id="why">
  <div class="wrap reveal"><h2>{p.whyTitle}</h2><p>{p.whyBody}</p></div>
</section>
<section class="section" id="lines">
  <div class="wrap">
    <h2 class="reveal">{p.linesTitle}</h2>
    <div class="grid cols-3">
      {researchLines.map((l) => (
        <a class="card line reveal" style={`--c:${l.accent}`} href={`${prefix}/research/${l.slug}/`}>
          <span class="badge"><LineIcon slug={l.slug} /><span class="tag">{l.letter}</span></span>
          <h3>{tr(l.title, lang)}</h3>
          <p class="muted">{tr(l.simple, lang)}</p>
          <p>{tr(l.topics, lang).map((m) => <span class="tag">{m}</span>)}</p>
          <span class="go">{pages[lang].readMore} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="section alt" id="methods">
  <div class="wrap reveal">
    <h2>{p.methodsTitle}</h2>
    <p>{methods.map((m) => <span class="tag">{m}</span>)}</p>
  </div>
</section>
<section class="section" id="reading">
  <div class="wrap reveal">
    <h2>{p.readingTitle}</h2>
    <ul class="reading">
      {reading.map((r) => (
        <li><a href={r.href} rel="noopener">{r.title}</a><br /><span class="muted">{r.authors} · {r.venue}, {r.year}</span></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .toc { display: flex; gap: .5rem 1.5rem; flex-wrap: wrap; padding-top: 1rem; padding-bottom: 1rem; font-weight: 500; }
  .card { display: block; text-decoration: none; color: inherit; }
  .card h3 { color: var(--ink); }
  .tag { margin: 0 .35rem .35rem 0; }
  .reading { padding-left: 1.2rem; display: grid; gap: .9rem; max-width: var(--measure); }
  .go { color: var(--c, var(--brand)); font-weight: 600; }
</style>
