---
import { nav, ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = ui[lang];
const item = nav.find((n) => n.slug === slug)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'pt' ? `${base}/pt` : base;
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{t.labName}</p>
    <h1>{item[lang]}</h1>
    <p class="muted">{t.placeholderPage}</p>
    <p><a href={`${prefix}/`}>← {t.back}</a></p>
  </div>
</section>
