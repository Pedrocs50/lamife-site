---
import PageHead from './PageHead.astro';
import { ui, type Lang } from '../i18n/ui';
import { pages } from '../i18n/pages';
import { projects, partners, networks, funding, tools, researchLines, tr } from '../data/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pages[lang].projects;
---
<PageHead title={p.title} lead={p.lead} eyebrow={ui[lang].labName} />
<section class="section">
  <div class="wrap">
    <div class="filters" role="group" aria-label="Filter by research line">
      <button class="chip on" data-line="all">{p.filterAll}</button>
      {researchLines.map((l) => <button class="chip" data-line={l.slug}>{tr(l.title, lang)}</button>)}
    </div>
    <div class="grid cols-3" id="project-list">
      {projects.map((x) => (
        <article class="card" data-line={x.line}>
          <span class="tag">{p[x.status]}</span>
          <h3>{tr(x.title, lang)}</h3>
          <p class="muted">{tr(x.summary, lang)}</p>
          {x.href && <p class="small"><a href={x.href} rel="noopener">{p.visit} →</a></p>}
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section alt">
  <div class="wrap">
    <h2>{p.partnersTitle}</h2>
    <p>{partners.map((n) => <span class="tag">{n}</span>)}</p>
    <h2 class="sub">{p.networksTitle}</h2>
    <ul>{networks.map((n) => <li><a href={n.href} rel="noopener">{n.name}</a></li>)}</ul>
    <h2 class="sub">{p.fundingTitle}</h2>
    <p>{funding.map((n) => <span class="tag">{n}</span>)}</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2>{p.toolsTitle}</h2>
    <div class="grid cols-3">
      {tools.map((t) => (
        <article class="card">
          <h3 class="mono">{t.name}</h3>
          <p class="muted">{tr(t.description, lang)}</p>
          <p class="small"><a href={t.href} rel="noopener">GitHub →</a></p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .chip { font: inherit; font-size: .9rem; padding: .4rem .9rem; border-radius: var(--radius); border: 1px solid var(--brand); background: transparent; color: var(--brand); cursor: pointer; }
  .chip.on, .chip:hover { background: var(--brand); color: #fff; }
  .small { font-size: .9rem; color: var(--ink-soft); }
  .mono { font-family: var(--font-mono); font-size: 1rem; }
  .sub { margin-top: 2rem; }
  .tag { margin: 0 .35rem .35rem 0; }
  .logo { display: grid; place-items: center; min-height: 90px; color: var(--ink-soft); }
</style>
<script is:inline>
  document.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', c === b));
    const line = b.dataset.line;
    document.querySelectorAll('#project-list .card').forEach((c) => { c.hidden = line !== 'all' && c.dataset.line !== line; });
  }));
</script>
