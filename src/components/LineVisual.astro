---
// Animated picture for the header of each research line page.
// Pure SVG + CSS, drawn in the line's own color (inherits --c from the page head).
import type { Lang } from '../i18n/ui';
interface Props { slug: string; lang: Lang }
const { slug, lang } = Astro.props;

const alt: Record<string, { en: string; pt: string }> = {
  'space-physics': { en: 'The Sun releases a flare whose wavefronts travel to Earth and disturb its magnetic field.', pt: 'O Sol libera uma explosão cujas frentes de onda viajam até a Terra e perturbam seu campo magnético.' },
  'environmental-physics': { en: 'Rain falls and the water level rises above a danger threshold.', pt: 'A chuva cai e o nível da água sobe acima de um limite de alerta.' },
  energy: { en: 'Particles circle inside a tokamak until the plasma becomes unstable and breaks down.', pt: 'Partículas circulam dentro de um tokamak até o plasma ficar instável e se desfazer.' },
  health: { en: 'A heartbeat trace scrolls by with one irregular beat highlighted.', pt: 'Um traçado de batimentos cardíacos passa com uma batida irregular destacada.' },
};

function rng(seed: number) {
  return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const r = rng(7);
const stars = Array.from({ length: 36 }, () => ({ x: r() * 480, y: r() * 300, r: 0.6 + r() * 1.3, o: 0.2 + r() * 0.45, d: (r() * 5).toFixed(2) }));

// Sun rays (space physics).
const rays = Array.from({ length: 14 }, (_, i) => {
  const a = (i * 2 * Math.PI) / 14, c = Math.cos(a), s = Math.sin(a);
  return { x1: 90 + 44 * c, y1: 150 + 44 * s, x2: 90 + (i % 2 ? 52 : 58) * c, y2: 150 + (i % 2 ? 52 : 58) * s };
});

// Water (environmental physics): two wave layers that repeat every 480 units.
const wave = (amp: number, k: number, base: number, phase: number) => {
  let d = `M0 ${base}`;
  for (let x = 0; x <= 960; x += 8) d += ` L${x} ${(base + amp * Math.sin((x / 480) * Math.PI * 2 * k + phase)).toFixed(1)}`;
  return `${d} L960 400 L0 400 Z`;
};
const w1 = wave(9, 2, 0, 0), w2 = wave(7, 3, 0, 1.7);
const drops = Array.from({ length: 9 }, (_, i) => ({ x: 70 + i * 36 + (i % 2) * 9, d: ((i * 0.37) % 1.6).toFixed(2) }));

// Heartbeat (health): five beats, the third one irregular; the pattern repeats every 600 units.
let ecg = 'M20 170';
for (let b = 0; b < 10; b++) {
  const o = 20 + b * 120, odd = b % 5 === 2;
  ecg += odd
    ? ` L${o + 30} 170 L${o + 40} 180 L${o + 54} 70 L${o + 72} 214 L${o + 84} 170 Q${o + 100} 196 ${o + 114} 170 L${o + 120} 170`
    : ` L${o + 18} 170 Q${o + 26} 156 ${o + 34} 170 L${o + 46} 170 L${o + 52} 178 L${o + 58} 108 L${o + 64} 196 L${o + 70} 170 L${o + 84} 170 Q${o + 96} 148 ${o + 108} 170 L${o + 120} 170`;
}
---
<svg class="line-visual" viewBox="0 0 480 300" role="img" aria-label={alt[slug]?.[lang] ?? ''}>
  {slug === 'space-physics' && (<g aria-hidden="true">
    {stars.map((s) => <circle class="star" cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} style={`--o:${s.o.toFixed(2)};--d:${s.d}s`} />)}
    <g class="rays">{rays.map((q) => <line x1={q.x1.toFixed(1)} y1={q.y1.toFixed(1)} x2={q.x2.toFixed(1)} y2={q.y2.toFixed(1)} />)}</g>
    <circle class="sun" cx="90" cy="150" r="34" />
    <circle class="front" cx="90" cy="150" r="34" />
    <circle class="front f2" cx="90" cy="150" r="34" />
    <circle class="front f3" cx="90" cy="150" r="34" />
    <path class="shield" d="M372 104 Q336 150 372 196" />
    <circle class="earth" cx="404" cy="150" r="14" />
  </g>)}

  {slug === 'environmental-physics' && (<g aria-hidden="true">
    <path class="cloud" d="M120 82 a16 16 0 0 1 3 -31.6 a24 24 0 0 1 46 6 a13 13 0 0 1 -2 25.6 Z" transform="translate(90 -6) scale(1.5)" />
    {drops.map((d) => <line class="drop" x1={d.x} x2={d.x - 4} y1="104" y2="122" style={`--d:${d.d}s`} />)}
    <line class="limit" x1="20" x2="460" y1="196" y2="196" />
    <g class="level"><g class="swell a"><path d={w1} transform="translate(0 232)" /></g><g class="swell b"><path d={w2} transform="translate(0 242)" /></g></g>
  </g>)}

  {slug === 'energy' && (<g aria-hidden="true">
    <ellipse class="vessel" cx="240" cy="150" rx="168" ry="112" />
    <ellipse class="surface" cx="240" cy="150" rx="132" ry="86" />
    <ellipse class="surface" cx="240" cy="150" rx="96" ry="62" />
    <g transform="translate(240 150) scale(1 .65)">
      <circle class="plasma" cx="0" cy="0" r="105" />
      {[0, 1, 2, 3, 4, 5].map((i) => <g class="spin" style={`--d:${-i * 0.9}s`}><circle class="bead" cx="105" cy="0" r="5" /></g>)}
    </g>
    <polyline class="bolt" points="232,52 214,98 242,98 224,150" />
  </g>)}

  {slug === 'health' && (<g aria-hidden="true">
    <rect class="panel" x="20" y="50" width="440" height="200" rx="2" />
    {[90, 130, 170, 210].map((y) => <line class="gridline" x1="20" x2="460" y1={y} y2={y} />)}
    <clipPath id="ecg-clip"><rect x="20" y="50" width="440" height="200" /></clipPath>
    <g clip-path="url(#ecg-clip)"><g class="scroll">
      <rect class="flag" x="290" y="62" width="64" height="176" rx="2" /><rect class="flag" x="890" y="62" width="64" height="176" rx="2" />
      <path class="trace" d={ecg} />
    </g></g>
  </g>)}
</svg>
<style>
  .line-visual { width: 100%; height: auto; display: block; overflow: hidden; }
  .star { fill: var(--ink-soft); fill-opacity: var(--o); animation: twinkle 4.5s ease-in-out var(--d) infinite; }

  /* A: space physics */
  .rays line { stroke: currentColor; stroke-width: 2; stroke-linecap: round; opacity: .6; }
  .rays { transform-origin: 90px 150px; animation: spin 40s linear infinite; }
  .sun { fill: currentColor; fill-opacity: .14; stroke: currentColor; stroke-width: 2.4; }
  .front { fill: none; stroke: currentColor; stroke-width: 1.6; vector-effect: non-scaling-stroke; opacity: 0; transform-box: fill-box; transform-origin: center; animation: front 6s ease-out infinite; }
  .front.f2 { animation-delay: .35s; stroke-dasharray: 5 6; }
  .front.f3 { animation-delay: .7s; stroke-opacity: .6; }
  .shield { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; opacity: .5; animation: hit 6s ease-in-out infinite; }
  .earth { fill: currentColor; fill-opacity: .18; stroke: currentColor; stroke-width: 2.4; }

  /* B: environmental physics */
  .cloud { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linejoin: round; }
  .drop { stroke: currentColor; stroke-width: 2; stroke-linecap: round; opacity: 0; animation: rain 1.6s linear var(--d) infinite; }
  .limit { stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 6 6; }
  .level { animation: rise 9s ease-in-out infinite alternate; }
  .swell path { fill: currentColor; }
  .swell.a path { fill-opacity: .22; }
  .swell.b path { fill-opacity: .16; }
  .swell.a { animation: drift 7s linear infinite; }
  .swell.b { animation: drift 11s linear infinite reverse; }

  /* C: energy */
  .vessel { fill: none; stroke: currentColor; stroke-width: 2.4; opacity: .7; }
  .surface { fill: none; stroke: currentColor; stroke-width: 1; stroke-opacity: .3; }
  .plasma { fill: none; stroke: currentColor; stroke-width: 3; transform-box: fill-box; transform-origin: center; animation: unstable 9s ease-in-out infinite; }
  .spin { transform-box: view-box; transform-origin: 0 0; animation: spin 5.4s linear var(--d) infinite; }
  .bead { fill: currentColor; }
  .bolt { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linejoin: round; opacity: 0; animation: flash 9s ease-out infinite; }

  /* D: health */
  .panel { fill: rgba(255, 255, 255, .86); stroke: var(--line); stroke-width: 1.5; }
  .gridline { stroke: var(--surface); stroke-width: 1; }
  .trace { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .flag { fill: var(--accent); fill-opacity: .10; stroke: var(--accent); stroke-opacity: .5; stroke-dasharray: 4 4; }
  .scroll { animation: scroll 9s linear infinite; }

  @keyframes twinkle { 0%, 100% { fill-opacity: var(--o); } 50% { fill-opacity: calc(var(--o) * .35); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes front { 0% { transform: scale(1); opacity: 0; } 8% { opacity: .75; } 78% { transform: scale(9); opacity: .35; } 100% { transform: scale(10.5); opacity: 0; } }
  @keyframes hit { 0%, 62% { stroke: currentColor; opacity: .5; stroke-width: 2.4; } 74% { stroke: var(--accent); opacity: 1; stroke-width: 4; } 92%, 100% { stroke: currentColor; opacity: .5; stroke-width: 2.4; } }
  @keyframes rain { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: .8; } 100% { transform: translateY(70px); opacity: 0; } }
  @keyframes rise { from { transform: translateY(40px); } to { transform: translateY(-62px); } }
  @keyframes drift { to { transform: translateX(-480px); } }
  @keyframes unstable {
    0%, 50% { transform: none; stroke: currentColor; }
    62% { transform: rotate(3deg) scale(1.02, .98); }
    72% { transform: rotate(-5deg) scale(1.06, .93); }
    82% { transform: rotate(6deg) scale(.96, 1.08); stroke: var(--accent); }
    90% { transform: scale(1.18); stroke: var(--accent); opacity: .5; }
    100% { transform: none; stroke: currentColor; opacity: 1; }
  }
  @keyframes flash { 0%, 80% { opacity: 0; } 84% { opacity: 1; } 94%, 100% { opacity: 0; } }
  @keyframes scroll { to { transform: translateX(-600px); } }

  /* Without motion, show a still picture. */
  @media (prefers-reduced-motion: reduce) {
    .star, .rays, .front, .shield, .drop, .level, .swell, .plasma, .spin, .bolt, .scroll { animation: none; }
    .front { opacity: .35; transform: scale(5); }
    .front.f2, .front.f3 { opacity: 0; }
    .drop { opacity: .6; }
    .level { transform: translateY(-20px); }
  }
</style>
