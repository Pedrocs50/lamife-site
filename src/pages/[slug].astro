---
import Base from '../layouts/Base.astro';
import StubPage from '../components/StubPage.astro';
import { nav } from '../i18n/ui';
export function getStaticPaths() {
  return nav.map((n) => ({ params: { slug: n.slug } }));
}
const { slug } = Astro.params;
const item = nav.find((n) => n.slug === slug)!;
---
<Base lang="en" title={item.en} slug={slug}><StubPage lang="en" slug={slug!} /></Base>
